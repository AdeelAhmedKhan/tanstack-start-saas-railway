# Copy to .env for local dev. NEVER commit a real .env, and never put a
# real secret in this file. Placeholders only.
# On Railway, set these as service variables instead.

# --- App ---
# Public base URL of the deployed app (used for Stripe redirects).
APP_URL=http://localhost:3000
# Better Auth base URL. Must match the URL the app is served from.
BETTER_AUTH_URL=http://localhost:3000
# Port for local dev only. Railway injects $PORT at runtime; srvx reads it.
PORT=3000

# --- Database (Postgres) ---
# Local: a Postgres you run yourself. Railway: reference variable
# ${{Postgres.DATABASE_URL}} on the app service.
DATABASE_URL=postgresql://user:password@localhost:5432/tanstack_saas

# --- Auth ---
# 32+ random characters. Generate one with: openssl rand -base64 32
# Rotate it if it ever leaks; rotating logs out every session.
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# --- Seed admin (scripts/seed.ts only; never used by the app at runtime) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-strong-password

# --- Stripe (billing is env-gated: without these, /pricing shows
# "billing not configured" and checkout throws a friendly error) ---
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
# Price for the Pro plan, created in the Stripe dashboard (test mode first).
STRIPE_PRICE_ID=price_replace-me
# Webhook endpoint secret for /api/stripe/webhook (Stripe dashboard >
# Developers > Webhooks). Leave empty in local dev to skip verification.
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# --- Uploads / Railway Bucket (S3-compatible, env-gated) ---
# On Railway: add a Bucket service and reference its variables here.
# Locally: any S3-compatible store (MinIO etc.), or leave empty to
# disable uploads — the dashboard shows "storage not configured".
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional public base URL for files (CDN / bucket public URL).
S3_PUBLIC_URL=
